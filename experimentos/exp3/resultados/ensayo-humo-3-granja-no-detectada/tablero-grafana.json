dPos":{"h":1,"w":24,"x":0,"y":14},"id":12,"title":"Reporte de seguridad — lo que registra bd_auditoria y lo que dispara S-2 (sigue el rango de tiempo del tablero)","type":"row"},{"datasource":{"type":"grafana-postgresql-datasource","uid":"pgseg"},"description":"Una fila por tipo. La detección en ms tiene resolución de 1 ms; el p95 fino está en la gráfica de arriba.","fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"gridPos":{"h":9,"w":10,"x":0,"y":15},"id":13,"options":{"cellHeight":"sm"},"targets":[{"datasource":{"type":"grafana-postgresql-datasource","uid":"pgseg"},"editorMode":"code","format":"table","rawQuery":true,"rawSql":"SELECT CASE tipo_atacante WHEN 'bot_individual' THEN 'Bot individual' WHEN 'granja_cuentas' THEN 'Granja de cuentas' WHEN 'acaparador' THEN 'Acaparador de asientos' ELSE 'Sin etiqueta' END AS \"Tipo de atacante\", count(*) AS \"Cuentas marcadas\", count(DISTINCT actor_ip) AS \"IP distintas\", round(avg((detalle-\u003e\u003e'solicitudes_en_ventana')::numeric), 1) AS \"Solicitudes antes de la marca\", round(percentile_cont(0.95) WITHIN GROUP (ORDER BY (ts_evidencia - ts_evento_detector))::numeric, 1) AS \"p95 detección (ms)\", string_agg(DISTINCT detalle-\u003e\u003e'regla', ', ') AS \"Regla que disparó\", to_char(min(ts), 'HH24:MI:SS') AS \"Primera\", to_char(max(ts), 'HH24:MI:SS') AS \"Última\" FROM auditoria_seguridad WHERE tipo = 'ATAQUE_DETECTADO' AND $__timeFilter(ts) GROUP BY 1 ORDER BY 2 DESC","refId":"A"}],"title":"Resumen por tipo de atacante","type":"table"},{"datasource":{"type":"grafana-postgresql-datasource","uid":"pgseg"},"description":"Las 12 marcas más recientes.","fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"gridPos":{"h":9,"w":14,"x":10,"y":15},"id":14,"options":{"cellHeight":"sm"},"targets":[{"datasource":{"type":"grafana-postgresql-datasource","uid":"pgseg"},"editorMode":"code","format":"table","rawQuery":true,"rawSql":"SELECT to_char(ts, 'HH24:MI:SS.MS') AS \"Hora\", CASE tipo_atacante WHEN 'bot_individual' THEN 'Bot individual' WHEN 'granja_cuentas' THEN 'Granja de cuentas' WHEN 'acaparador' THEN 'Acaparador de asientos' ELSE 'Sin etiqueta' END AS \"Tipo\", actor_cuenta AS \"Cuenta\", actor_ip AS \"IP\", detalle-\u003e\u003e'regla' AS \"Regla\", (detalle-\u003e\u003e'solicitudes_en_ventana')::int AS \"Solicitudes en la ventana\", (ts_evidencia - ts_evento_detector) AS \"Detección (ms)\" FROM auditoria_seguridad WHERE tipo = 'ATAQUE_DETECTADO' AND $__timeFilter(ts) ORDER BY id DESC LIMIT 12","refId":"A"}],"title":"Últimas marcas (evidencia: cuenta, IP, hora)","type":"table"},{"collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":24},"id":15,"title":"S-2  Recuperarse del ataque — medida: p95 ≤ 300 ms (desde la alerta hasta asientos liberados + órdenes canceladas + cuentas revocadas)","type":"row"},{"datasource":{"type":"prometheus","uid":"prom"},"description":"Verde = cumple S-2 (≤ 300 ms).","fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"decimals":4,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":0.3}]},"unit":"s"},"overrides":[]},"gridPos":{"h":6,"w":3,"x":0,"y":25},"id":16,"options":{"colorMode":"background","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"]}},"targets":[{"datasource":{"type":"prometheus","uid":"prom"},"expr":"histogram_quantile(0.95, sum(rate(taq_recuperacion_seconds_bucket[5m])) by (le))","instant":true,"refId":"A"}],"title":"p95 de recuperación","type":"stat"},{"datasource":{"type":"prometheus","uid":"prom"},"description":"Para que el p95 cumpla debe ser ≥ 95 %.","fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"decimals":1,"max":100,"min":0,"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":95}]},"unit":"percent"},"overrides":[]},"gridPos":{"h":6,"w":3,"x":3,"y":25},"id":17,"options":{"colorMode":"background","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"]}},"targets":[{"datasource":{"type":"prometheus","uid":"prom"},"expr":"100 * sum(increase(taq_recuperacion_seconds_bucket{le=\"0.3\"}[5m])) / sum(increase(taq_recuperacion_seconds_count[5m]))","instant":true,"refId":"A"}],"title":"% de recuperaciones ≤ 300 ms","type":"stat"},{"datasource":{"type":"prometheus","uid":"prom"},"description":"","fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"decimals":0,"thresholds":{"mode":"absolute","steps":[{"color":"blue","value":null}]},"unit":"short"},"overrides":[]},"gridPos":{"h":6,"w":3,"x":6,"y":25},"id":18,"options":{"colorMode":"background","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"]}},"targets":[{"datasource":{"type":"prometheus","uid":"prom"},"expr":"sum(taq_bloqueo_liberados_ataque_total) or vector(0)","instant":true,"refId":"A"}],"title":"Asientos liberados","type":"stat"},{"datasource":{"type":"prometheus","uid":"prom"},"description":"","fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"decimals":0,"thresholds":{"mode":"absolute","steps":[{"color":"blue","value":null}]},"unit":"short"},"overrides":[]},"gridPos":{"h":6,"w":3,"x":9,"y":25},"id":19,"options":{"colorMode":"background","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"]}},"targets":[{"datasource":{"type":"prometheus","uid":"prom"},"expr":"sum(taq_ordenes_canceladas_total) or vector(0)","instant":true,"refId":"A"}],"title":"Órdenes canceladas","type":"stat"},{"datasource":{"type":"prometheus","uid":"prom"},"description":"","fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"decimals":0,"thresholds":{"mode":"absolute","steps":[{"color":"blue","value":null}]},"unit":"short"},"overrides":[]},"gridPos":{"h":6,"w":3,"x":12,"y":25},"id":20,"options":{"colorMode":"background","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"]}},"targets":[{"datasource":{"type":"prometheus","uid":"prom"},"expr":"sum(taq_cuentas_revocadas_total) or vector(0)","instant":true,"refId":"A"}],"title":"Cuentas revocadas","type":"stat"},{"datasource":{"type":"prometheus","uid":"prom"},"descri