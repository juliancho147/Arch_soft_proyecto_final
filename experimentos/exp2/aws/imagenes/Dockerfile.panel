# Panel de inyección (Python estándar) + kubectl para "Reiniciar estado" dentro del clúster. Contexto: experimentos/
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL -o /usr/local/bin/kubectl https://dl.k8s.io/release/v1.31.0/bin/linux/arm64/kubectl && chmod +x /usr/local/bin/kubectl
COPY exp1/control /app
WORKDIR /app
EXPOSE 8088
CMD ["python3", "servidor.py"]
